{
  "routes": [
    {
      "src": "/void/(.*)",
      "dest": "https://waste-my-token-production.up.railway.app/void/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://waste-my-token-production.up.railway.app/api/$1"
    },
    {
      "src": "/trap/(.*)",
      "dest": "https://waste-my-token-production.up.railway.app/trap/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|svg|json|woff|woff2|ttf))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
